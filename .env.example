# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — it never gets committed or pushed.

# Supabase project settings → Project Settings → Data API / API Keys
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The GitHub repo this app lives in, as owner/repo
GITHUB_REPO=mattbrowndesigns-byte/Specimen

# A GitHub Personal Access Token that can trigger this repo's workflows
GITHUB_DISPATCH_TOKEN=

# A password you make up yourself. Must match the CALLBACK_SECRET
# GitHub Actions secret exactly.
CALLBACK_SECRET=
