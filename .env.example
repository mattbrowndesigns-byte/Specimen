# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — it never gets committed or pushed.

# Supabase project settings → Project Settings → Data API / API Keys
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The GitHub repo this app lives in, as owner/repo
GITHUB_REPO=mattbrowndesigns-byte/Specimen

# A GitHub Personal Access Token that can trigger this repo's workflows
GITHUB_DISPATCH_TOKEN=

# A password you make up yourself. Must match the CALLBACK_SECRET
# GitHub Actions secret exactly.
CALLBACK_SECRET=

# Free API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Sign-in. These two ARE exposed to the browser, which is what the
# NEXT_PUBLIC_ prefix means and why the anon key is the only Supabase key
# allowed here. Row Level Security is what makes that safe.
# Supabase project settings -> Project Settings -> Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The one account allowed to issue invite codes.
OWNER_EMAIL=
